@* ====================================
   Título: Dashboard.razor
   Descrição: Painel principal da área administrativa
   ==================================== *@

@page "/admin"
@layout Portfolio.Web.Layout.AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ContactMessageService MessageService

<PageTitle>Dashboard - WPDev Admin</PageTitle>

<div class="dashboard">
    <div class="dashboard__header">
        <h1 class="dashboard__title">Dashboard</h1>
        <p class="dashboard__subtitle">Bem-vindo ao painel WPDev.</p>
    </div>

    <div class="dashboard__grid">
        <a class="dash-card" href="/admin/projects" style="background-image: url('/images/admin/dash-projects.webp')">
            <div class="dash-card__overlay"></div>
            <div class="dash-card__content">
                <span class="dash-card__label">Projetos</span>
                <span class="dash-card__arrow">→</span>
            </div>
        </a>

        <a class="dash-card" href="/admin/blog" style="background-image: url('/images/admin/dash-blog.webp')">
            <div class="dash-card__overlay"></div>
            <div class="dash-card__content">
                <span class="dash-card__label">Blog</span>
                <span class="dash-card__arrow">→</span>
            </div>
        </a>

        <a class="dash-card" href="/admin/timeline" style="background-image: url('/images/admin/dash-timeline.webp')">
            <div class="dash-card__overlay"></div>
            <div class="dash-card__content">
                <span class="dash-card__label">Timeline</span>
                <span class="dash-card__arrow">→</span>
            </div>
        </a>

        <a class="dash-card" href="/admin/now" style="background-image: url('/images/admin/dash-now.webp')">
            <div class="dash-card__overlay"></div>
            <div class="dash-card__content">
                <span class="dash-card__label">Now</span>
                <span class="dash-card__arrow">→</span>
            </div>
        </a>

        <a class="dash-card" href="/admin/messages" style="background-image: url('/images/admin/dash-messages.webp')">
            <div class="dash-card__overlay"></div>
            @if (unreadCount > 0)
            {
                <span class="dash-card__badge">@unreadCount</span>
            }
            <div class="dash-card__content">
                <span class="dash-card__label">Mensagens</span>
                <span class="dash-card__arrow">→</span>
            </div>
        </a>
    </div>
</div>

@code {
    private int unreadCount = 0;

    protected override async Task OnInitializedAsync()
    {
        unreadCount = await MessageService.GetUnreadCountAsync();
    }
}

<style>
    .dashboard {
        padding: 0;
    }

    .dashboard__header {
        margin-bottom: 40px;
    }

    .dashboard__title {
        font-family: 'Poppins', sans-serif;
        font-size: 2rem;
        font-weight: 800;
        color: #0D1C24;
        letter-spacing: -0.02em;
        margin: 0 0 8px;
    }

    .dashboard__subtitle {
        color: #A3A9AB;
        font-size: 0.95rem;
        margin: 0;
    }

    .dashboard__grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
    }

    .dash-card {
        position: relative;
        display: flex;
        align-items: flex-end;
        min-height: 220px;
        border-radius: 14px;
        overflow: hidden;
        background-size: cover;
        background-position: center;
        text-decoration: none;
        color: #fff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .dash-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(13, 28, 36, 0.25);
    }

    .dash-card__overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(13,28,36,0.15) 0%, rgba(13,28,36,0.85) 100%);
        transition: background 0.2s ease;
    }

    .dash-card:hover .dash-card__overlay {
        background: linear-gradient(180deg, rgba(108,158,163,0.15) 0%, rgba(13,28,36,0.9) 100%);
    }

    .dash-card__content {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding: 20px 24px;
    }

    .dash-card__label {
        font-family: 'Poppins', sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: -0.01em;
    }

    .dash-card__arrow {
        font-size: 1.1rem;
        opacity: 0.85;
        transition: transform 0.2s ease;
    }

    .dash-card:hover .dash-card__arrow {
        transform: translateX(4px);
    }

    .dash-card__badge {
        position: absolute;
        top: 16px;
        right: 16px;
        z-index: 2;
        background-color: #e5484d;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        min-width: 22px;
        height: 22px;
        border-radius: 999px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 7px;
    }
</style>