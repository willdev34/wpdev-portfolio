@* ====================================
   Título: AdminBlogForm.razor
   Descrição: Formulário de criação e edição de posts do blog
   ==================================== *@

@page "/admin/blog/new"
@page "/admin/blog/edit/{Id:guid}"
@layout Portfolio.Web.Layout.AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Portfolio.Web.DTOs.BlogPosts
@using Portfolio.Web.Helpers
@inject BlogPostService BlogPostService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(_isEdit ? "Editar Post" : "Novo Post") - WPDev Admin</PageTitle>

<div class="admin-page">

    <div class="admin-page__header">
        <div>
            <a class="back-link" href="/admin/blog">← Blog</a>
            <h1 class="admin-page__title">@(_isEdit ? "Editar Post" : "Novo Post")</h1>
        </div>
    </div>

    @if (_isLoading)
    {
        <p class="admin-loading">Carregando...</p>
    }
    else
    {
        <div class="form-grid">

            <div class="form-section">
                <h2 class="form-section__title">Informações Principais</h2>

                <div class="field">
                    <label class="field__label">Título *</label>
                    <input class="field__input"
                           value="@_form.Title"
                           @oninput="GenerateSlug"
                           placeholder="Título do post" />
                </div>

                <div class="field">
                    <label class="field__label">Slug *</label>
                    <input class="field__input"
                           @bind="_form.Slug"
                           placeholder="url-do-post" />
                </div>

                <div class="field">
                    <label class="field__label">Resumo *</label>
                    <textarea class="field__textarea"
                              @bind="_form.Excerpt"
                              placeholder="Resumo do post"
                              rows="3"></textarea>
                </div>

                <div class="field">
                    <label class="field__label">Conteúdo * (Markdown)</label>
                    <textarea class="field__textarea field__textarea--tall"
                              @bind="_form.Content"
                              placeholder="# Título&#10;&#10;Escreva em Markdown..."
                              rows="12"></textarea>
                </div>

                <div class="field">
                    <label class="field__label">Tempo de leitura (min)</label>
                    <input class="field__input"
                           type="number"
                           @bind="_form.ReadTimeMinutes" />
                </div>

                <div class="field field--checkbox">
                    <input type="checkbox" id="featured" @bind="_form.IsFeatured" />
                    <label for="featured">Post em destaque</label>
                </div>
            </div>

            <div class="form-column">
            <div class="form-section">
                <h2 class="form-section__title">Publicação</h2>

                @if (_isEdit && !string.IsNullOrEmpty(_originalStatus))
                {
                    <p class="publish-current">
                        Status atual:
                        <span class="status-badge status-badge--@_originalStatus.ToLower()">@StatusLabel(_originalStatus)</span>
                    </p>
                }

                <div class="publish-options">
                    <label class="publish-option @(_publishMode == PublishMode.Now ? "publish-option--active" : "")">
                        <input type="radio"
                               name="publish-mode"
                               checked="@(_publishMode == PublishMode.Now)"
                               @onchange="() => SetPublishMode(PublishMode.Now)" />
                        <span>
                            <strong>Publicar agora</strong>
                            <small>O post fica visível em /blog assim que for salvo.</small>
                        </span>
                    </label>

                    <label class="publish-option @(_publishMode == PublishMode.Schedule ? "publish-option--active" : "")">
                        <input type="radio"
                               name="publish-mode"
                               checked="@(_publishMode == PublishMode.Schedule)"
                               @onchange="() => SetPublishMode(PublishMode.Schedule)" />
                        <span>
                            <strong>Agendar</strong>
                            <small>O post é publicado automaticamente na data escolhida.</small>
                        </span>
                    </label>
                </div>

                @if (_publishMode == PublishMode.Schedule)
                {
                    <div class="field">
                        <label class="field__label" for="scheduled-at">Data e hora (horário de Brasília)</label>
                        <input class="field__input"
                               id="scheduled-at"
                               type="datetime-local"
                               min="@BrasiliaTimeHelper.Now.ToString("yyyy-MM-ddTHH:mm")"
                               @bind="_scheduledLocal"
                               @bind:format="yyyy-MM-ddTHH:mm" />
                    </div>
                }
            </div>

            <div class="form-section">
                <h2 class="form-section__title">Mídia e Tags</h2>

                <div class="field">
                    <label class="field__label">Imagem de capa</label>
                    <ImageUpload CurrentUrl="@_form.FeaturedImageUrl"
                                 OnUrlChanged="@OnImageUrlChanged" />
                </div>

                <div class="field">
                    <label class="field__label">Tags</label>
                    <div class="tech-input-row">
                        <input class="field__input"
                               @bind="_newTag"
                               @onkeydown="HandleTagKeyDown"
                               placeholder="Ex: .NET, Tutorial..." />
                        <button class="btn-add-tech" type="button" @onclick="AddTag">+</button>
                    </div>
                    <div class="tech-tags">
                        @foreach (var tag in _form.Tags)
                        {
                            <span class="tech-tag">
                                @tag
                                <button type="button" @onclick="() => RemoveTag(tag)">×</button>
                            </span>
                        }
                    </div>
                </div>
            </div>
            </div>

        </div>

        <div class="form-actions-wrapper">
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="form-error">@_errorMessage</div>
            }
            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <div class="form-success">@_successMessage</div>
            }
            <div class="form-actions">
                <a class="btn-cancel" href="/admin/blog">Cancelar</a>
                @if (!_isPublishedPost)
                {
                    <button class="btn-draft" @onclick="SaveDraft" disabled="@_isSaving">
                        @(_savingStatus == StatusDraft ? "Salvando..." : "Salvar Rascunho")
                    </button>
                }
                <button class="btn-save" @onclick="SavePost" disabled="@_isSaving">
                    @(_isSaving && _savingStatus != StatusDraft ? "Salvando..." : "Salvar Post")
                </button>
            </div>
        </div>
    }

</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private bool _isEdit => Id.HasValue;
    private bool _isLoading = true;
    private bool _isSaving = false;
    private string _errorMessage = string.Empty;
    private string _successMessage = string.Empty;
    private string _newTag = string.Empty;

    private CreateBlogPostDto _form = new();

    // ====================================
    // PUBLICAÇÃO (Status e agendamento)
    // ====================================
    // Valores do enum BlogPostStatus na API: 0=Draft, 1=Scheduled, 2=Published
    private const int StatusDraft = 0;
    private const int StatusScheduled = 1;
    private const int StatusPublished = 2;

    private enum PublishMode { Now, Schedule }

    private PublishMode _publishMode = PublishMode.Now;
    private DateTime? _scheduledLocal; // horário de Brasília digitado no input
    private string _originalStatus = string.Empty; // "Draft", "Scheduled" ou "Published" (vem da API)
    private int? _savingStatus;

    // Post já publicado não mostra "Salvar Rascunho", para não despublicar sem querer
    private bool _isPublishedPost => _isEdit && _originalStatus == "Published";

    protected override async Task OnInitializedAsync()
    {
        if (_isEdit)
        {
            var post = await BlogPostService.GetByIdAdminAsync(Id!.Value);

            if (post is null)
            {
                await JS.InvokeVoidAsync("eval", "window.location.href='/admin/blog'");
                return;
            }

            _form = new CreateBlogPostDto
            {
                Title = post.Title,
                Slug = post.Slug,
                Excerpt = post.Excerpt,
                Content = post.Content,
                FeaturedImageUrl = post.FeaturedImageUrl,
                Tags = new List<string>(post.Tags),
                IsFeatured = post.IsFeatured,
                IsPublished = post.IsPublished,
                ReadTimeMinutes = post.ReadTimeMinutes
            };

            _originalStatus = post.Status;

            if (post.Status == "Scheduled" && post.ScheduledAt.HasValue)
            {
                _publishMode = PublishMode.Schedule;
                _scheduledLocal = BrasiliaTimeHelper.FromUtc(post.ScheduledAt.Value);
            }
        }

        _isLoading = false;
    }

    private void GenerateSlug(ChangeEventArgs e)
    {
        var title = e.Value?.ToString() ?? string.Empty;
        _form.Title = title;

        if (!_isEdit)
        {
            _form.Slug = title.ToLower()
                .Replace(" ", "-")
                .Replace("ã", "a").Replace("â", "a").Replace("á", "a").Replace("à", "a")
                .Replace("é", "e").Replace("ê", "e")
                .Replace("í", "i")
                .Replace("ó", "o").Replace("ô", "o")
                .Replace("ú", "u")
                .Replace("ç", "c")
                .Replace("ñ", "n");
        }
    }

    private void SetPublishMode(PublishMode mode)
    {
        _publishMode = mode;
        _errorMessage = string.Empty;
    }

    // ====================================
    // SALVAR RASCUNHO - Status 0, não exige data
    // ====================================
    private Task SaveDraft() => HandleSubmit(StatusDraft, null);

    // ====================================
    // SALVAR POST - Status 2 (agora) ou Status 1 com ScheduledAt (agendar)
    // ====================================
    private async Task SavePost()
    {
        if (_publishMode == PublishMode.Now)
        {
            await HandleSubmit(StatusPublished, null);
            return;
        }

        if (!_scheduledLocal.HasValue)
        {
            _errorMessage = "Para agendar, informe a data e a hora da publicação.";
            return;
        }

        if (_scheduledLocal.Value <= BrasiliaTimeHelper.Now)
        {
            _errorMessage = "A data de agendamento precisa estar no futuro (horário de Brasília).";
            return;
        }

        await HandleSubmit(StatusScheduled, BrasiliaTimeHelper.ToUtc(_scheduledLocal.Value));
    }

    private async Task HandleSubmit(int status, DateTime? scheduledAtUtc)
    {
        if (string.IsNullOrWhiteSpace(_form.Title) ||
            string.IsNullOrWhiteSpace(_form.Slug) ||
            string.IsNullOrWhiteSpace(_form.Content))
        {
            _errorMessage = "Título, slug e conteúdo são obrigatórios.";
            return;
        }

        _isSaving = true;
        _savingStatus = status;
        _errorMessage = string.Empty;

        _form.Status = status;
        _form.ScheduledAt = scheduledAtUtc;
        _form.IsPublished = status == StatusPublished;

        if (_isEdit)
        {
            var updateDto = new UpdateBlogPostDto
            {
                Id = Id!.Value,
                Title = _form.Title,
                Slug = _form.Slug,
                Excerpt = _form.Excerpt,
                Content = _form.Content,
                FeaturedImageUrl = _form.FeaturedImageUrl,
                Tags = _form.Tags,
                IsPublished = _form.IsPublished,
                IsFeatured = _form.IsFeatured,
                ReadTimeMinutes = _form.ReadTimeMinutes,
                Status = _form.Status,
                ScheduledAt = _form.ScheduledAt
            };

            var (success, error) = await BlogPostService.UpdateAsync(updateDto);

            if (!success)
            {
                _errorMessage = error ?? "Erro ao atualizar post.";
                _isSaving = false;
                _savingStatus = null;
                return;
            }
        }
        else
        {
            var (success, error) = await BlogPostService.CreateAsync(_form);

            if (!success)
            {
                _errorMessage = error ?? "Erro ao criar post.";
                _isSaving = false;
                _savingStatus = null;
                return;
            }
        }

        _successMessage = status switch
        {
            StatusDraft => "Rascunho salvo com sucesso.",
            StatusScheduled => $"Post agendado para {_scheduledLocal:dd/MM/yyyy 'às' HH:mm} (horário de Brasília).",
            _ => _isEdit ? "Post atualizado e publicado com sucesso." : "Post publicado com sucesso."
        };
        _isSaving = false;
        _savingStatus = null;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(5000);
        await JS.InvokeVoidAsync("eval", "window.location.href='/admin/blog'");
    }

    private Task OnImageUrlChanged(string url)
    {
        _form.FeaturedImageUrl = url;
        return Task.CompletedTask;
    }

    private void AddTag()
    {
        var tag = _newTag.Trim();
        if (!string.IsNullOrWhiteSpace(tag) && !_form.Tags.Contains(tag))
            _form.Tags.Add(tag);
        _newTag = string.Empty;
    }

    private async Task HandleTagKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddTag();
        await Task.CompletedTask;
    }

    private void RemoveTag(string tag) => _form.Tags.Remove(tag);

    private static string StatusLabel(string status) => status switch
    {
        "Draft" => "Rascunho",
        "Scheduled" => "Agendado",
        "Published" => "Publicado",
        _ => status
    };
}
