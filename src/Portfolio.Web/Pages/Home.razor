@* ====================================
   Título: Home.razor
   Descrição: Página inicial editorial WPDev
   Refatorada: design editorial, componentes,
               estilos movidos para Home.razor.css
   ==================================== *@

@page "/"
@using Portfolio.Web.Services
@using Portfolio.Application.Helpers
@using Portfolio.Web.DTOs.Projects
@using Portfolio.Web.DTOs.BlogPosts
@using Portfolio.Web.Components
@using Portfolio.Web.Helpers
@implements IDisposable
@inject HomeDataCache DataCache
@inject IJSRuntime JS

<SeoHead Title="WPDev - Portfólio de William, Desenvolvedor Full Stack"
         Description="Portfólio de William, desenvolvedor Full Stack especialista em .NET, Blazor WebAssembly e arquitetura de software. Projetos, blog técnico e timeline de carreira"
         Path="/" />

<!-- ================================
     HERO
     ================================ -->
<section class="home-hero">
    <img id="hero-poster" 
        class="hero-bg-poster" 
        src="/images/hero-poster.webp" 
        alt="" 
        aria-hidden="true"
        fetchpriority="high"
        decoding="async"
        width="1280"
        height="720" />
    <video id="hero-video" class="hero-bg-video" autoplay muted loop playsinline preload="none">
        <source id="hero-video-source" src="" type="video/mp4" />
        <track kind="captions" srclang="pt" label="Português" default />
    </video>
    <div class="hero-overlay"></div>
    <div class="container">
        <div class="hero-inner">

            <div class="hero-text">
                <p class="hero-eyebrow">Desenvolvedor Full Stack</p>
                <h1 class="hero-title">
                    Construindo<br />
                    software que<br />
                    <span class="hero-title-accent">importa<span class="hero-cursor">.</span><span class="hero-cursor-blink">|</span></span>
                </h1>
            </div>

            <div class="hero-desc">
                <p class="hero-subtitle">
                    Portfólio de projetos com foco em arquitetura limpa,
                    código de qualidade e experiência de usuário bem pensada.
                </p>
                <div class="hero-actions">
                    <a href="/projects" class="home-btn home-btn--primary">
                        Ver projetos
                    </a>
                    <a href="/contact" class="home-btn home-btn--ghost">
                        Entrar em contato
                    </a>
                </div>
            </div>

        </div>
    </div>

    <!-- Linha decorativa no rodapé do hero -->
    <div class="hero-bottom-line">
        <div class="container">
            <hr class="hero-divider" />
        </div>
    </div>
</section>

<!-- ================================
     PROJETOS EM DESTAQUE
     ================================ -->
<section class="home-section scroll-reveal">
    <div class="container">

        <div class="section-header">
            <p class="section-eyebrow">Trabalhos recentes</p>
            <h2 class="section-title">Projetos em destaque</h2>
        </div>

        @if (isLoading)
        {
            @* Esqueleto com a mesma geometria do layout final (principal + menores): a proporção 3:2 já reserva o espaço *@
            <div class="featured-grid" aria-hidden="true">
                <div class="featured-item featured-item--primary">
                    <div class="featured-thumb featured-skeleton"></div>
                    <div class="featured-info">
                        <div class="featured-skeleton featured-skeleton--tags"></div>
                        <div class="featured-skeleton featured-skeleton--title"></div>
                        <div class="featured-skeleton featured-skeleton--line"></div>
                        <div class="featured-skeleton featured-skeleton--line featured-skeleton--short"></div>
                    </div>
                </div>
                <div class="featured-stack">
                    @for (var i = 0; i < FeaturedSecondaryCount; i++)
                    {
                        <div class="featured-item featured-item--compact">
                            <div class="featured-thumb featured-skeleton"></div>
                            <div class="featured-info">
                                <div class="featured-skeleton featured-skeleton--tags"></div>
                                <div class="featured-skeleton featured-skeleton--title featured-skeleton--title-small"></div>
                                <div class="featured-skeleton featured-skeleton--line"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (featuredPrimary is not null)
        {
            @* Cada card tem UM link (o título); a área clicável do card inteiro é estendida por CSS (::after).
               As tags são texto, não links: nada de <a> dentro de <a>. As imagens são decorativas (alt vazio),
               porque o título já nomeia o card. *@
            <div class="featured-grid">

                <!-- Projeto principal: fixo, o mais recente entre os destaques -->
                <article class="featured-item featured-item--primary">
                    <div class="featured-thumb">
                        @if (!string.IsNullOrEmpty(featuredPrimary.ImageUrl))
                        {
                            <img src="@CloudinaryUrlHelper.Optimize(featuredPrimary.ImageUrl, CloudinaryUrlHelper.HeroWidth)"
                                 srcset="@CloudinaryUrlHelper.BuildSrcSet(featuredPrimary.ImageUrl, PrimaryImageWidths)"
                                 sizes="@PrimaryImageSizes"
                                 alt="" width="1200" height="800" loading="lazy" decoding="async" />
                        }
                        else
                        {
                            <div class="featured-thumb-placeholder"></div>
                        }
                    </div>
                    <div class="featured-info">
                        <div class="featured-tech-row">
                            @foreach (var tech in TechnologyNormalizer.NormalizeAll(featuredPrimary.Technologies).Take(3))
                            {
                                <span class="featured-tech">@tech</span>
                            }
                        </div>
                        <h3 class="featured-title"><a class="featured-link" href="/projects/@featuredPrimary.Id">@featuredPrimary.Title</a></h3>
                        <p class="featured-desc">@featuredPrimary.ShortDescription</p>
                    </div>
                </article>

                <!-- Projetos sorteados: cards horizontais -->
                <div class="featured-stack">
                    @foreach (var project in featuredSecondary)
                    {
                        <article class="featured-item featured-item--compact">
                            <div class="featured-thumb">
                                @if (!string.IsNullOrEmpty(project.ImageUrl))
                                {
                                    <img src="@CloudinaryUrlHelper.Optimize(project.ImageUrl, CloudinaryUrlHelper.ThumbnailWidth)"
                                         alt="" width="480" height="320" loading="lazy" decoding="async" />
                                }
                                else
                                {
                                    <div class="featured-thumb-placeholder"></div>
                                }
                            </div>
                            <div class="featured-info">
                                <div class="featured-tech-row">
                                    @foreach (var tech in TechnologyNormalizer.NormalizeAll(project.Technologies).Take(2))
                                    {
                                        <span class="featured-tech">@tech</span>
                                    }
                                </div>
                                <h3 class="featured-title featured-title--small"><a class="featured-link" href="/projects/@project.Id">@project.Title</a></h3>
                                <p class="featured-desc featured-desc--small">@project.ShortDescription</p>
                            </div>
                        </article>
                    }
                </div>

            </div>

            <div class="section-cta">
                <a href="/projects" class="home-btn home-btn--ghost">
                    Ver todos os projetos →
                </a>
            </div>
        }        else
        {
            <div class="home-empty">
                <p>Nenhum projeto em destaque ainda.</p>
            </div>
        }

    </div>
</section>

<!-- ================================
     ÚLTIMOS POSTS
     Fora da espera da splash: entra quando os posts chegam.
     Oculta se não houver posts (ou se a busca falhar).
     ================================ -->
@if (latestPosts.Count > 0)
{
    <section class="home-section home-section--posts scroll-reveal">
        <div class="container">

            <div class="section-header">
                <p class="section-eyebrow">Do blog</p>
                <h2 class="section-title">Últimos posts</h2>
            </div>

            <div class="latest-posts-grid">
                @foreach (var post in latestPosts)
                {
                    <BlogPostCard Post="post" OnClick="() => OpenPost(post.Id)" />
                }
            </div>

            <div class="section-cta">
                <a href="/blog" class="home-btn home-btn--ghost">
                    Ver todos os posts →
                </a>
            </div>

        </div>
    </section>
}

<!-- ================================
     INTRODUÇÃO: TIMELINE (fundo escuro)
