@code {
    private List<ProjectCardDto> projects = new();
    private bool isLoading = true;

    // Destaques: o principal é fixo (CreatedAt mais recente) e os menores são sorteados com a semente da sessão
    private const string FeaturedSeedKey = "wpdev-featured-seed";
    private const int FeaturedSecondaryCount = 3;

    // Imagem do principal: três larguras e o espaço que ela ocupa (a coluna maior no desktop, a largura toda abaixo de 900px)
    private static readonly int[] PrimaryImageWidths = { 480, 800, 1200 };
    private const string PrimaryImageSizes = "(max-width: 900px) calc(100vw - 3rem), 780px";
    private ProjectCardDto? featuredPrimary;
    private List<ProjectCardDto> featuredSecondary = new();

    protected override async Task OnInitializedAsync()
    {
        // Consome do cache que já começou no boot do WASM (Program.cs).
        // Se os dados já chegaram, retorna na hora. Se não, aguarda
        // o resto do tempo aqui, mas em paralelo com o boot do Blazor.
        projects = await DataCache.GetFeaturedAsync();

        // O sorteio acontece aqui, antes do primeiro render da seção: nada troca depois de aparecer
        await SelectFeaturedAsync();
        isLoading = false;

        // Os últimos posts NÃO entram na espera da splash: carregam em segundo plano
        // e a seção aparece quando chegarem (ou fica oculta se falhar).
        _ = LoadPostsAsync();
    }

    private async Task SelectFeaturedAsync()
    {
        var stored = await ReadFeaturedSeedAsync();
        var seed = FeaturedSelector.ResolveSeed(stored, Random.Shared.Next(), out var isNew);

        if (isNew)
        {
            await WriteFeaturedSeedAsync(seed.ToString(System.Globalization.CultureInfo.InvariantCulture));
        }

        var selection = FeaturedSelector.Pick(projects, p => p.CreatedAt, FeaturedSecondaryCount, seed);
        featuredPrimary = selection.Primary;
        featuredSecondary = selection.Secondary.ToList();
    }

    // JSInterop só com strings. Qualquer falha do storage vira "sem semente guardada": usa uma por carregamento
    private async Task<string?> ReadFeaturedSeedAsync()
    {
        try
        {
            return await JS.InvokeAsync<string?>("wpdevSessionGet", FeaturedSeedKey);
        }
        catch
        {
            return null;
        }
    }

    private async Task WriteFeaturedSeedAsync(string seed)
    {
        try
        {
            await JS.InvokeVoidAsync("wpdevSessionSet", FeaturedSeedKey, seed);
        }
        catch
        {
            // Sem storage: segue com a semente só desta página
        }
    }

    private List<BlogPostCardDto> latestPosts = new();
    private bool _disposed = false;
    private bool _postsRevealInitialized = false;

    private async Task LoadPostsAsync()
    {
        try
        {
            var posts = await DataCache.GetLatestPostsAsync();

            // O usuário pode ter navegado para outra página enquanto os posts carregavam
            if (_disposed) return;

            latestPosts = posts ?? new List<BlogPostCardDto>();
            await InvokeAsync(() =>
            {
                if (!_disposed) StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            // Falha nos posts nunca pode impedir a Home de aparecer
            Console.WriteLine($"[Home] Falha ao carregar os últimos posts: {ex.Message}");
        }
    }

    // Regra do projeto: navegação por JS (NavigationManager.NavigateTo falha em silêncio
    // em Release por causa da serialização por reflection do JSInterop)
    private async Task OpenPost(Guid postId)
    {
        await JS.InvokeVoidAsync("eval", $"window.location.href='/blog/{postId}'");
    }

    public void Dispose() => _disposed = true;

    private bool _scrollRevealInitialized = false;
    private bool _videoLoaded = false;
    private bool _splashHidden = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Carrega o vídeo só depois que a página renderizar
        if (firstRender && !_videoLoaded)
        {
            _videoLoaded = true;
            await JS.InvokeVoidAsync("loadHeroVideo",
                "hero-video-source",
                "https://res.cloudinary.com/do0uq7w4n/video/upload/q_auto,f_auto/v1782685612/hero-code-optimized_oun8qf.mp4");

            // Roda o scroll-reveal no primeiro render, garantindo que
            // seções estáticas (Skills, CTA) fiquem visíveis mesmo
            // se os projetos ainda não chegaram.
            await JS.InvokeVoidAsync("setupScrollReveal");
        }

        // Quando os projetos chegam, novos elementos entram no DOM.
        // Roda o scroll-reveal de novo pra observá-los.
        // No firstRender, já roda o scroll-reveal pra seções estáticas
        if (firstRender)
        {
            await JS.InvokeVoidAsync("setupScrollReveal");
        }

        // Quando os projetos chegam, novos elementos entram no DOM,
        // roda de novo pra observá-los
        if (!_scrollRevealInitialized && projects != null && projects.Count > 0)
        {
            _scrollRevealInitialized = true;
            await JS.InvokeVoidAsync("setupScrollReveal");
        }

        // Quando os posts chegam, a seção "Últimos posts" entra no DOM:
        // roda de novo pra observá-la
        if (!_postsRevealInitialized && latestPosts.Count > 0)
        {
            _postsRevealInitialized = true;
            await JS.InvokeVoidAsync("setupScrollReveal");
        }

        // A splash (logo WPDev) só some quando isLoading virar false,
        // ou seja, quando os dados featured já chegaram. Hero e
        // projetos aparecem juntos, sem o usuário ver a transição
        // no meio do carregamento.
        if (!isLoading && !_splashHidden)
        {
            _splashHidden = true;
            await JS.InvokeVoidAsync("wpdevHideSplash");
        }
    }
}