@page "/timeline"
@using Portfolio.Web.Services
@using Portfolio.Web.DTOs.Timeline
@using Portfolio.Web.Helpers
@inject TimelineService TimelineService
@inject IJSRuntime JS

<SeoHead Title="Timeline - WPDev"
         Description="Trajetória profissional de William: formação, experiências e marcos da carreira como desenvolvedor Full Stack."
         Path="/timeline" />

<div class="timeline-page">

    <!-- Hero Section -->
    <section class="timeline-hero">
        <span class="hero-eyebrow">JORNADA PROFISSIONAL</span>
        <h1 class="hero-title">Timeline</h1>
        <p class="hero-description">
            Minha jornada profissional em desenvolvimento,
            marcos importantes e evolução de carreira.
        </p>
    </section>

    <!-- Timeline Section -->
    <section class="timeline-section scroll-reveal">

        @if (isLoading)
        {
            <div style="display: flex; flex-direction: column; gap: 24px;">
                @for (int i = 0; i < 4; i++)
                {
                    <LoadingSkeleton Variant="SkeletonVariant.Card" />
                }
            </div>
        }
        else if (!events.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">🗓️</div>
                <h3>Timeline em construção</h3>
                <p>Em breve a timeline profissional estará disponível.</p>
            </div>
        }
        else
        {
            <ul class="skill-legend" aria-label="Legenda das habilidades">
                <li><span class="legend-swatch legend-stack"></span>Stack</li>
                <li><span class="legend-swatch legend-hard"></span>Hard skill</li>
                <li><span class="legend-swatch legend-soft"></span>Soft skill</li>
            </ul>

            <div class="timeline-container">
                @for (int index = 0; index < events.Count; index++)
                {
                    var evt = events[index];
                    var cardSide = SkillNetworkLayout.CardSide(index);
                    var networkSide = SkillNetworkLayout.NetworkSide(index);
                    var skills = evt.Skills.OrderBy(s => s.Order).ToList();
                    var positions = SkillNetworkLayout.Compute(index, networkSide, skills.Count);

                    <div class="timeline-item @(cardSide == SkillNetworkSide.Right ? "timeline-item--right" : "timeline-item--left")"
                         style="--net-min-height: @(Num(SkillNetworkLayout.RequiredHeight(skills.Count)))px;">

                        <!-- Marker -->
                        <div class="timeline-marker">
                            <div class="marker-dot @(evt.Type == "Work" ? "marker-current" : "")"></div>
                        </div>

                        <div class="timeline-body">

                            <!-- Date -->
                            <div class="timeline-date">
                                <span>@evt.Date.ToString("MMM yyyy")</span>
                                @if (evt.IsCurrent)
                                {
                                    <span class="date-separator">→</span>
                                    <span class="date-current">Atual</span>
                                }
                                else if (evt.EndDate.HasValue)
                                {
                                    <span class="date-separator">→</span>
                                    <span>@evt.EndDate.Value.ToString("MMM yyyy")</span>
                                }
                                <span class="type-badge">@TimelineTypeHelper.Label(evt.Type)</span>
                            </div>

                            <!-- Card -->
                            <div class="timeline-card">
                                @if (!string.IsNullOrEmpty(evt.IconUrl))
                                {
                                    <div class="card-icon">
                                        <img src="@CloudinaryUrlHelper.Optimize(evt.IconUrl, CloudinaryUrlHelper.IconWidth)"
                                             alt="@evt.Title"
                                             loading="lazy"
                                             decoding="async"
                                             width="80"
                                             height="80" />
                                    </div>
                                }
                                <div class="card-content">
                                    <h3 class="card-title">@evt.Title</h3>
                                    <p class="card-description">@evt.Description</p>
                                    @if (!string.IsNullOrEmpty(evt.LinkUrl))
                                    {
                                        <a href="@evt.LinkUrl" target="_blank" class="card-link">
                                            @(string.IsNullOrEmpty(evt.LinkText) ? "Ver mais" : evt.LinkText) →
                                        </a>
                                    }
                                </div>
                            </div>

                        </div>

                        <!-- Rede de habilidades: bolhas ao redor do ponto no desktop, chips embaixo do card no mobile -->
                        @if (skills.Count > 0)
                        {
                            <div class="skill-network" data-event-index="@index" data-side="@(networkSide == SkillNetworkSide.Left ? "left" : "right")">
                                @for (int i = 0; i < skills.Count; i++)
                                {
                                    var skill = skills[i];
                                    var pos = positions[i];
                                    <span class="skill-bubble skill-bubble--@CategoryKey(skill.Category)"
                                          title="@skill.Name"
                                          data-name="@skill.Name"
                                          data-category="@CategoryKey(skill.Category)"
                                          data-angle="@Num(pos.Angle)"
                                          data-distance="@Num(pos.Distance)"
                                          data-phase="@Num(pos.Phase)"
                                          data-amplitude="@Num(pos.Amplitude)"
                                          style="--x: @(Num(pos.X))px; --y: @(Num(pos.Y))px;">@skill.Name</span>
                                }
                            </div>
                        }

                    </div>
                }
            </div>
        }

    </section>

</div>

@code {

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (events.Count > 0)
        {
            await JS.InvokeVoidAsync("setupScrollReveal");
        }
    }
    private List<TimelineEventDto> events = new();
    private bool isLoading = true;

    // Categoria da API (Stack, HardSkill, SoftSkill) em chave de classe CSS; desconhecida cai em hard
    private static string CategoryKey(string category) => category switch
    {
        "Stack" => "stack",
        "SoftSkill" => "soft",
        _ => "hard"
    };

    // Número com ponto decimal, independente da cultura do navegador
    private static string Num(double value) => value.ToString(System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        await LoadTimeline();
    }

    private async Task LoadTimeline()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            events = await TimelineService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar timeline: {ex.Message}");
            events = new List<TimelineEventDto>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}