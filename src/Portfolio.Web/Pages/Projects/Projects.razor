@page "/projects"
@using Portfolio.Web.DTOs.Projects
@using Portfolio.Web.Services
@using Portfolio.Web.Helpers
@using Portfolio.Application.Helpers
@inject ProjectService ProjectService
@inject NavigationManager Navigation
@inject IJSRuntime JS


<SeoHead Title="Projetos - WPDev"
         Description="Conheça os projetos desenvolvidos por William: aplicações .NET, Blazor, APIs REST e soluções de arquitetura limpa para clientes e portfólio pessoal."
         Path="/projects" />

<div class="projects-page">
    <!-- Hero Section -->
    <section class="projects-hero">
        <span class="hero-eyebrow">PORTFÓLIO</span>
        <h1 class="hero-title">Projetos</h1>
        <p class="hero-description">
            Uma coleção curada de trabalhos que refletem minha jornada como desenvolvedor,
            explorando diferentes tecnologias e soluções criativas.
        </p>
    </section>

    <!-- Search & Filters Section -->
    <section class="projects-controls scroll-reveal">
        <div class="controls-wrapper">
            <!-- Search Bar -->
            <div class="search-container">
                <SearchBar 
                    @bind-Value="searchQuery"
                    Placeholder="Buscar projetos por nome ou descrição..."
                    OnSearch="HandleSearch" />
            </div>

            <!-- Filter Chips -->
            <div class="filters-container">
                <span class="filters-label">Tecnologias:</span>
                <div class="filters-area">
                    <div id="@TechFilterId" class="filters-chips @(filtersExpanded ? "filters-chips--expanded" : "")">
                        @foreach (var tech in availableTechnologies)
                        {
                            <FilterChip 
                                Label="@tech"
                                IsActive="selectedTechnologies.Contains(tech)"
                                OnClick="() => ToggleTechnology(tech)" />
                        }
                    </div>
                    @* Botão "+" / "−": só aparece (CSS via data-overflow) quando os chips passam de 2 linhas.
                       O rótulo é constante e o estado vai em aria-expanded; o glifo é decorativo. *@
                    <button type="button"
                            class="filters-toggle @(TechnologyFilterHelper.ShowsSelectedCount(selectedTechnologies.Count, filtersExpanded) ? "filters-toggle--count" : "")"
                            aria-label="@TechnologyFilterHelper.BuildToggleLabel(selectedTechnologies.Count, filtersExpanded)"
                            aria-expanded="@(filtersExpanded ? "true" : "false")"
                            aria-controls="@TechFilterId"
                            @onclick="ToggleFiltersExpanded">
                        <span aria-hidden="true">@(filtersExpanded ? "−" : "+")</span>
                        @* A quantidade visível é decorativa: o aria-label já anuncia "Todas as tecnologias (N)" *@
                        @if (TechnologyFilterHelper.ShowsSelectedCount(selectedTechnologies.Count, filtersExpanded))
                        {
                            <span class="filters-toggle__count" aria-hidden="true">@selectedTechnologies.Count</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- Projects Grid -->
    <section class="projects-grid scroll-reveal">
        @if (isLoading)
        {
            <!-- Loading Skeletons -->
            <div class="grid">
                @for (int i = 0; i < pageSize; i++)
                {
                    <LoadingSkeleton Variant="SkeletonVariant.Card" />
                }
            </div>
        }
        else if (filteredProjects == null || !filteredProjects.Any())
        {
            <!-- Empty State -->
            <div class="empty-state">
                <div class="empty-icon">🔍</div>
                <h3>Nenhum projeto encontrado</h3>
                <p>Tente ajustar os filtros ou realizar uma nova busca.</p>
                @if (!string.IsNullOrEmpty(searchQuery) || selectedTechnologies.Any())
                {
                    <Button 
                        Variant="ButtonVariant.Secondary"
                        OnClick="ClearFilters">
                        Limpar Filtros
                    </Button>
                }
            </div>
        }
        else
        {
            <!-- Projects Cards -->
            <div class="grid">
                @foreach (var project in paginatedProjects)
                {
                    <Card 
                        Title="@project.Title"
                        Description="@project.ShortDescription"
                        ImageUrl="@project.ImageUrl"
                        Badge="@FormatBadge(project)"
                        OnClick="() => NavigateToProject(project.Id)">
                        <BodyContent>
                            @foreach (var tech in TechnologyNormalizer.NormalizeAll(project.Technologies))
                            {
                                <span class="tech-tag">@tech</span>
                            }
                        </BodyContent>
                    </Card>
                }
            </div>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <div class="pagination-container">
                    <Pagination 
                        CurrentPage="currentPage"
                        TotalPages="totalPages"
                        OnPageChange="HandlePageChange" />
                </div>
            }
        }
    </section>
</div>

@code {
    // ============================================
    // STATE MANAGEMENT
    // ============================================
    
    [SupplyParameterFromQuery(Name = "tech")]
    public string? TechFilter { get; set; }

    // Data
    private List<ProjectCardDto> allProjects = new();
    private List<ProjectCardDto> filteredProjects = new();
    private List<ProjectCardDto> paginatedProjects = new();
    
    // Search & Filters
    private string searchQuery = string.Empty;
    private HashSet<string> selectedTechnologies = new();
    private List<string> availableTechnologies = new();
    private bool filtersExpanded;
    private const string TechFilterId = "tech-filter-chips";
    
    // Pagination
    private int currentPage = 1;
    private int pageSize = 9; // 3x3 grid
    private int totalPages => (int)Math.Ceiling((double)filteredProjects.Count / pageSize);
    
    // UI State
    private bool isLoading = true;

    // ============================================
    // LIFECYCLE METHODS
    // ============================================
    
    protected override async Task OnInitializedAsync()
    {
        await LoadProjects();
    }

    // ============================================
    // DATA LOADING
    // ============================================
    
    private async Task LoadProjects()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // Buscar todos os projetos da API
            allProjects = await ProjectService.GetAllAsync();

            // Tecnologias disponiveis, calculadas a partir dos projetos reais
            // (nomes canônicos e sem variações como CSS3 e CSS 3)
            availableTechnologies = TechnologyFilterHelper.BuildAvailable(allProjects.Select(p => p.Technologies));

            // Pre-seleciona a tecnologia vinda pela URL, se houver (ex: /projects?tech=Blazor)
            if (!string.IsNullOrWhiteSpace(TechFilter))
            {
                // O valor da URL passa pelo normalizador, então links antigos (?tech=CSS 3) continuam valendo
                var match = TechnologyFilterHelper.ResolveFromQuery(TechFilter, availableTechnologies);

                if (match is not null)
                {
                    selectedTechnologies.Add(match);
                    // O chip selecionado pode estar além da 2ª linha: começa expandido para ele ficar visível
                    filtersExpanded = true;
                }
            }

            // Aplicar filtros
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar projetos: {ex.Message}");
            allProjects = new List<ProjectCardDto>();
            filteredProjects = new List<ProjectCardDto>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ============================================
    // FILTERING & PAGINATION
    // ============================================
    
    private void ApplyFilters()
    {
        // Começar com todos os projetos
        var query = allProjects.AsEnumerable();

        // Aplicar busca por texto
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var search = searchQuery.ToLower();
            query = query.Where(p => 
                p.Title.ToLower().Contains(search) || 
                (p.ShortDescription?.ToLower().Contains(search) ?? false)
            );
        }

        // Aplicar filtro por tecnologias (casamento exato pela chave canônica, sem diferenciar maiúsculas)
        if (selectedTechnologies.Any())
        {
            query = query.Where(p => TechnologyFilterHelper.MatchesAny(p.Technologies, selectedTechnologies));
        }

        // Mais recentes primeiro (pelo ano real do projeto, nao pela data de cadastro)
        query = query.OrderByDescending(p => p.Year).ThenByDescending(p => p.CreatedAt);

        // Atualizar lista filtrada
        filteredProjects = query.ToList();

        // Aplicar paginação
        ApplyPagination();
    }

    private void ApplyPagination()
    {
        var skip = (currentPage - 1) * pageSize;
        paginatedProjects = filteredProjects
            .Skip(skip)
            .Take(pageSize)
            .ToList();
    }

    // ============================================
    // EVENT HANDLERS
    // ============================================
    
    private void HandleSearch()
    {
        // Reset para primeira página ao fazer nova busca
        currentPage = 1;
        ApplyFilters();
    }

    private void ToggleTechnology(string tech)
    {
        if (selectedTechnologies.Contains(tech))
        {
            selectedTechnologies.Remove(tech);
        }
        else
        {
            selectedTechnologies.Add(tech);
        }

        // Reset para primeira página ao alterar filtros
        currentPage = 1;
        ApplyFilters();
    }

    private void ToggleFiltersExpanded()
    {
        filtersExpanded = !filtersExpanded;
    }

    private void HandlePageChange(int newPage)
    {
        currentPage = newPage;
        ApplyPagination();
        StateHasChanged();
    }

    private void ClearFilters()
    {
        searchQuery = string.Empty;
        selectedTechnologies.Clear();
        currentPage = 1;
        ApplyFilters();
    }

    private async Task NavigateToProject(Guid projectId)
    {
        await JS.InvokeVoidAsync("eval", $"window.location.href='/projects/{projectId}'");
    }

    private static string FormatBadge(ProjectCardDto project)
    {
        var statusLabel = project.Status switch
        {
            "Completed" => "Concluído",
            "InProgress" => "Em andamento",
            "Planning" => "Planejamento",
            "Archived" => "Arquivado",
            _ => project.Status
        };

        return $"{project.Year} · {statusLabel}";
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isLoading && availableTechnologies.Count > 0)
        {
            // Só uma string: o JS mede as linhas dos chips e marca data-overflow
            await JS.InvokeVoidAsync("wpdevSetupTechFilter", TechFilterId);
        }

        if (paginatedProjects.Count > 0)
        {
            await JS.InvokeVoidAsync("setupScrollReveal");
        }
    }
}